rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collection `songs`: Khách được phép đọc toàn bộ dữ liệu công khai,
    // nhưng CHỈ tài khoản Admin đã đăng nhập mới được phép Thêm / Sửa / Xóa.
    // Vì hệ thống chỉ có đúng 1 tài khoản Auth của Admin, request.auth != null
    // là đủ để phân quyền an toàn giữa Admin và khách xem.
    match /songs/{songId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
